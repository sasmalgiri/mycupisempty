# ===========================================
# MyCupIsEmpty - Environment Variables
# ===========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin token for protected maintenance endpoints (generate a long random string)
SEED_ADMIN_TOKEN=

# Ollama AI Configuration (Oracle Cloud) — legacy fallback
# Replace with your Oracle VM public IP
OLLAMA_BASE_URL=http://your-oracle-vm-ip:11434
OLLAMA_MODEL=llama3.2

# xAI (Grok) — primary AI provider for Guru, Photo-Solve, Content-Gen,
# Practice-Generate, Auto-Flashcards, Parent-Digest letter, Growth Stories
# Get your key from: https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
# Vision-capable model for Photo-to-Solve + Handwriting Canvas
XAI_VISION_MODEL=grok-2-vision-latest

# Google Classroom integration (optional — leave blank to disable)
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft Teams for Education integration (optional)
# Register app at https://portal.azure.com → Azure AD → App registrations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
MS_TENANT_ID=common

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: Error Tracking
SENTRY_DSN=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Development: Skip VARK assessment requirement (set to 'true' to skip)
NEXT_PUBLIC_SKIP_ASSESSMENT=false
